{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "containerAppEnvId": {
      "value": "/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.App/managedEnvironments/billing-auto-env"
    },
    "acrLoginServer": {
      "value": "wtwbillingacr.azurecr.io"
    },
    "userAssignedIdentityId": {
      "value": "/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.ManagedIdentity/userAssignedIdentities/wtw-billing-auto-mi-eastus2"
    },
    "frontendImageName": {
      "value": "b2c-billing-frontend:latest"
    },
    "frontendCpu": {
      "value": 1
    },
    "frontendMemory": {
      "value": "2Gi"
    },
    "frontendPort": {
      "value": 3000
    },
    "backendImageName": {
      "value": "b2c-billing-backend:latest"
    },
    "backendCpu": {
      "value": 1
    },
    "backendMemory": {
      "value": "2Gi"
    },
    "backendPort": {
      "value": 8000
    }
  }
}
